    "stem_counts_RelAbund <- stem_counts_raw |>\n",
    "                        dplyr::group_by(Estuary, Site_id, Transect, Quadrat) |>\n",
    "                        #Get relative abundance at the quadrat level\n",
    "                        dplyr::mutate(rel_abund = StemCount/sum(StemCount)) |>\n",
    "                        dplyr::ungroup()\n",
    "\n",
    "dim(stem_counts_RelAbund)\n",
    "head(stem_counts_RelAbund)"
   ]
